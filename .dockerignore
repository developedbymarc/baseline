# Only backend/, backend.Tests/, frontend/, config/ and baseline.slnx are needed to build.

# Git and editors
.git
.gitignore
.github
.idea
.vs
.vscode
.zed
**/*.user
**/*.DotSettings.user

# Docs and repo files not used in the image
docs
README.md
**/README.md
Dockerfile
.dockerignore

# .NET build output
**/bin
**/obj
**/TestResults

# Frontend build output and installed packages
**/node_modules
frontend/build
frontend/.svelte-kit
frontend/.output
frontend/vite.config.*.timestamp-*

# Local data and secrets
**/*.db
**/*.db-shm
**/*.db-wal
**/.env
**/.env.*
**/*.key
**/*.pem
**/*.pfx
**/*.crt
**/.dev-keys
**/secrets.dev.yaml

# OS files
**/.DS_Store
**/Thumbs.db
